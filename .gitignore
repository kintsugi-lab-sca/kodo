node_modules/

# GSD per-repo lock runtime artifacts (ephemeral; never committed). The lock and
# its steal-guard/tmp siblings live under the tracked .planning/ dir.
.planning/.kodo.lock
.planning/.kodo.lock.steal-guard
.planning/.kodo.lock.tmp.*
.planning/.kodo.lock.steal-guard.tmp.*

# Estado local efímero (runtime de kodo / cmux / omc) — nunca se commitea
.bg-shell/
.cmux/
.omc/
.DS_Store

# Tap de Homebrew: repo git propio clonado aquí, no un submódulo de este repo
homebrew-kodo/
